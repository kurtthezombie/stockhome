# Copy this file to .env.local and replace the placeholders with your Supabase project values.
# These values are browser-visible. Use the public anon/publishable key, never a service-role or secret key.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-or-publishable-key
